# Local Compose uses the bundled notification log sink. Production must set a human-operated webhook.
INBOX_STORAGE=sqlite
INBOX_WEBHOOK_URL=http://notification-sink:8081/notifications
INBOX_HOST_PORT=8080
INBOX_REGISTRY_FILE=./config/registry.json
INBOX_RETRY_INTERVAL=30s
INBOX_MAX_DOORBELL_ATTEMPTS=3
INBOX_REQUEST_SKEW=5m

# Required only for compose.postgres.yaml. Replace before use.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST_PORT=15432
# The Compose fallback URL requires a URI-safe password. If the raw password
# contains URI-reserved characters such as /, ?, #, %, or @, set this override
# with the password percent-encoded.
# INBOX_DATABASE_URL=postgres://agent_inbox:p%2Fa%3Fb%23c%25d@postgres:5432/agent_inbox?sslmode=disable
# For a separately managed PostgreSQL server, set INBOX_STORAGE=postgres and
# INBOX_DATABASE_URL=postgres://agent_inbox:...@db.example.com:5432/agent_inbox?sslmode=require
